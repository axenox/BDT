            {
                "caption": "Command line",
                "widgets": [
                    {
                        "widget_type": "Console",
                        "command_timeout": 3600,
                        "object_alias": "exface.Core.ACTION",
                        "id": "test_cli",
                        "allowed_commands": [
                            "/action.*/i",
                            "/behat.*/i",
                            "/git.*/i",
                            "/whoami/"
                        ],
                        "start_commands": [
                            "vendor/bin/action axenox.BDT:Behat init"
                        ],
                        "command_presets": [
                            {
                                "/*": "",
                                "caption": "Run suite",
                                "hint": "Run only the given test suite",
                                "commands": [
                                    "vendor/bin/action axenox.BDT:RunTest --suite=<Suite>"
                                ],
                                "*/": ""
                            },
                            {
                                "/*": "",
                                "caption": "Run file",
                                "hint": "Run a feature file",
                                "commands": [
                                    "vendor/bin/action axenox.BDT:RunTest \"vendor/<Filepath relative to vendor>\""
                                ],
                                "*/": ""
                            },
                            {
                                "/*": "",
                                "caption": "Run tags",
                                "hint": "Run tests marked with one or more tags",
                                "commands": [
                                    "vendor/bin/action axenox.BDT:RunTest --tags=<Tags (,)>"
                                ],
                                "*/": ""
                            },
                            {
                                "caption": "Run test",
                                "hint": "Runs Behat in a single process with live output. Fill at least one of suite, tags or feature.",
                                "commands": [
                                    "vendor/bin/action axenox.BDT:RunTest --suite=\"<Suite>\" --tags=\"<Tags>\" --feature=\"<File Path>\""
                                ]
                            },
                            {
                                "caption": "Run parallel",
                                "hint": "Runs Behat across parallel lanes and records one run. Fill at least one of suite, tags or feature.",
                                "commands": [
                                    "vendor/bin/action axenox.BDT:RunParallel --suite=\"<Suite>\" --tags=\"<Tags>\" --feature=\"<File Path>\""
                                ]
                            },
                            {
                                "caption": "Init",
                                "hint": "Set up this installation for testing",
                                "commands": [
                                    "vendor/bin/action axenox.BDT:Behat init"
                                ]
                            },
                            {
                                "caption": "Add app",
                                "hint": "Set up an app to be tested",
                                "commands": [
                                    "vendor/bin/action axenox.BDT:Behat init --addApp=<App alias>"
                                ]
                            }
                        ]
                    }
                ]
            }
        ]
